# Copy to .env for local overrides. Never commit real secrets.
# Production must supply secrets via the host secret manager — never reuse local defaults.

# --- PostgreSQL (Docker Compose + backend) ---
# Development-only password. Do NOT reuse in production.
POSTGRES_DB=quoteflow
POSTGRES_USER=quoteflow
POSTGRES_PASSWORD=quoteflow
POSTGRES_PORT=5432

# JDBC URL required (not postgres://). Convert platform URLs if needed.
DATABASE_URL=jdbc:postgresql://localhost:5432/quoteflow
DATABASE_USERNAME=quoteflow
DATABASE_PASSWORD=quoteflow

# --- Server / platform ---
# Railway injects PORT. Local may use SERVER_PORT.
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=
# Prod-like compose frontend origin example: http://localhost:8088
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Optional ops alias — set CORS_ALLOWED_ORIGINS explicitly (do not leave both empty in prod).
# APP_ALLOWED_ORIGINS=https://app.example.com

# --- JWT ---
# Development-only default exists in application.yml. Production MUST set a strong JWT_SECRET (≥32 bytes).
JWT_SECRET=replace-me-with-secure-value-at-least-32-bytes-long
JWT_ISSUER=quoteflow
JWT_AUDIENCE=quoteflow-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# --- Hikari (optional; keep small) ---
# HIKARI_MAXIMUM_POOL_SIZE=10
# HIKARI_MINIMUM_IDLE=2
# HIKARI_CONNECTION_TIMEOUT=30000

# --- JVM (containers) ---
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# --- Razorpay platform billing ---
# Local default: leave BILLING_ENABLED=false so FREE works without credentials.
BILLING_ENABLED=false
# BILLING_PROVIDER=RAZORPAY
# Production forbids FAKE when billing is enabled.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PRO_MONTHLY_PLAN_ID=
# RAZORPAY_PRO_ANNUAL_PLAN_ID=
# RAZORPAY_BUSINESS_MONTHLY_PLAN_ID=

# --- Email / notifications ---
# Local: CONSOLE. Hosted staging: DISABLED. Production: RESEND when domain verified.
EMAIL_PROVIDER=CONSOLE
# EMAIL_PROVIDER=DISABLED
EMAIL_FROM=noreply@quoteflow.local
EMAIL_FROM_NAME=QuoteFlow
# EMAIL_ALLOW_DEV_PROVIDER=false
# RESEND_API_KEY=
EMAIL_WORKER_ENABLED=true
# EMAIL_WORKER_BATCH_SIZE=20
# EMAIL_WORKER_INTERVAL=5s
# EMAIL_CLAIM_LEASE=10m

# --- Profiles ---
# Hosted staging: SPRING_PROFILES_ACTIVE=prod,staging
# SPRING_PROFILES_ACTIVE=prod,staging

# --- Frontend (public only; build-time for production Angular) ---
API_BASE_URL=/api/v1

# --- Prod-local compose ports (docker-compose.prod-local.yml) ---
# FRONTEND_PORT=8088
# BACKEND_PORT=8089

# --- AI (optional; backend-only; never Angular / config.json) ---
# Safe default: disabled. Core SaaS does not require Ollama.
AI_ENABLED=false
AI_PROVIDER=OLLAMA
AI_ADAPTER=spring-ai
# OLLAMA_BASE_URL=http://localhost:11434
# Recommended local model (do not hardcode in business logic):
# OLLAMA_MODEL=qwen3:8b
# Lower-resource fallback (manual switch only — never silent):
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_CONNECT_TIMEOUT=5s
# OLLAMA_READ_TIMEOUT=120s
# AI_LOG_PROMPTS=false
# AI_QUOTE_ASSISTANT_MAX_PROMPT=4000
# AI_QUOTE_ASSISTANT_RATE_USER=10
# AI_QUOTE_ASSISTANT_RATE_TENANT=30
# AI_COPILOT_MAX_MESSAGE=2000
# AI_COPILOT_MAX_TOOL_CALLS=6
# AI_COPILOT_RATE_USER=6
# AI_COPILOT_RATE_TENANT=20
# AI_COPILOT_EXPOSE_MODEL=false
# AI_ACTIONS_ENABLED=false
# AI_ACTION_APPROVAL_TTL=10m
# AI_ACTION_RATE_USER=6
# AI_ACTION_RATE_TENANT=20
# Payment reminder send uses EMAIL_* + EMAIL_SENDING entitlement; see docs/AI_PAYMENT_REMINDERS.md

# --- FUTURE: Redis ---
# REDIS_URL=
