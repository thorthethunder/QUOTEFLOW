# Copy/adapt notes for Cloudflare Pages same-origin API proxy.
#
# Preferred staging topology (implemented):
#   Pages Function: functions/api/[[path]].ts
#   Fixed backend: https://quoteflow-backend-staging.up.railway.app
#   SPA config.json: { "apiBaseUrl": "/api/v1" }
#
# Alternative _redirects proxy (no Function), keep /api above SPA catch-all:
#   /api/*  https://quoteflow-backend-staging.up.railway.app/api/:splat  200
#   /*      /index.html   200
#
# Prefer Function for explicit non-open-proxy + Cache-Control: private, no-store.
